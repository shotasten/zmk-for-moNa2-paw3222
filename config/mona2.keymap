#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER 0
#define NUM_FUNC_LAYER 1
#define FUNCTION_LAYER 2
#define SYMBOL_LAYER 3
#define SYSTEM_LAYER 4
#define SECONDARY_LAYER 5
#define TERTIARY_LAYER 6
#define MOUSE_LAYER 7
#define SCROLL_LAYER 8

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        shift_ctl: shift_ctl {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_CTL";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_SHIFT>, <&kp RCTRL>;
        };

        lr_ralt: lr_ralt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&m_rf_ralt>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_tab_top {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
        };

        combo_capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <10 11>;
        };

        combo_escape {
            bindings = <&kp ESCAPE>;
            key-positions = <3 4>;
        };

        combo_tab_home {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
        };

        zundastop {
            bindings = <&kp LA(LC(LG(S)))>;
            key-positions = <16 17>;
        };

        left_click {
            bindings = <&mkp MB1>;
            key-positions = <17 18>;
        };

        mid_click {
            bindings = <&mkp MB3>;
            key-positions = <18 17 19>;
        };

        right_click {
            bindings = <&mkp MB2>;
            key-positions = <18 19>;
        };
    };

    macros {
        pw: pw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp S &kp H &kp I &kp O &kp R &kp I &kp AT &kp NUMBER_0 &kp NUMBER_6 &kp NUMBER_0 &kp NUMBER_4 &kp ENTER>;
            label = "PW";
        };

        m_rf_ralt: m_rf_ralt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <75>;
            bindings = <&kp RALT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
&kp Q      &kp W               &kp E         &kp R         &kp T                                                                 &kp Y                    &kp U  &kp I      &kp O       &kp P
&kp A      &kp S               &kp D         &kp F         &kp G                                         &kp F18                 &kp H                    &kp J  &kp K      &kp L       &kp ENTER
&kp Z      &kp X               &kp C         &kp V         &kp B                     &kp C_MUTE          &lt 4 NON_US_BACKSLASH  &kp N                    &kp M  &kp COMMA  &kp PERIOD  &kp BACKSPACE
&kp LCTRL  &kp LA(LEFT_SHIFT)  &kp LEFT_GUI  &kp LEFT_ALT  &lt NUM_FUNC_LAYER SPACE  &kp LEFT_SHIFT      &mo FUNCTION_LAYER      &lr_ralt SYMBOL_LAYER 0                                &kp SLASH
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        num_func_layer {
            display-name = "num_func";
            bindings = <
&trans              &trans  &trans         &trans                &trans                                                 &kp KP_EQUAL  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DIVIDE
&kp LC(UP_ARROW)    &trans  &trans         &trans                &trans                                &trans           &kp KP_DOT    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MULTIPLY
&kp LC(DOWN_ARROW)  &trans  &kp LS(LG(S))  &kp LS(LA(NUMBER_4))  &kp LS(LA(NUMBER_5))  &kp C_MUTE      &kp KP_NUMBER_0  &kp KP_N0     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MINUS
&trans              &trans  &trans         &trans                &pw                   &pw             &kp BACKSPACE    &kp DELETE                                                       &kp KP_PLUS
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        function_layer {
            display-name = "func";
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                                 &kp LS(LG(LEFT_ARROW))  &kp LG(LS(RIGHT_ARROW))  &kp UP    &kp HOME   &kp END
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10                  &bt BT_SEL 0  &kp LSHFT               &kp LEFT                 &kp DOWN  &kp RIGHT  &kp SPACE
&kp F11  &kp F12  &trans  &trans  &trans   &kp C_MUTE      &trans        &kp LCTRL               &mkp MB4                 &trans    &mkp MB5   &kp DEL
&trans   &trans   &trans  &trans  &trans   &trans          &trans        &bt BT_SEL 0                                                          &kp RIGHT_ALT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        symbol_layer {
            display-name = "symbol";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN    &kp HASH      &kp DOLLAR         &kp PERCENT                            &kp AT_SIGN  &kp GRAVE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SQT
&kp CARET        &kp AMPERSAND  &kp ASTERISK  &kp GRAVE          &kp TILDE                &trans        &kp EQUAL    &kp PLUS        &kp LBKT              &kp RBKT               &kp DOUBLE_QUOTES
&kp SEMICOLON    &kp COLON      &kp SQT       &kp DOUBLE_QUOTES  &trans       &trans      &trans        &kp MINUS    &kp UNDERSCORE  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp COLON
&trans           &trans         &trans        &trans             &trans       &trans      &bt BT_SEL 1  &trans                                                                    &kp SEMI
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        system_layer {
            display-name = "system_layer";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10              &trans  &bootloader   &trans        &trans        &trans        &trans
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans   &trans   &trans   &trans   &trans   &trans      &trans  &trans                                                  &bt BT_CLR
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        secondary_layer {
            display-name = "secondary_layer";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                                &kp KP_NUMLOCK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS
&kp NUMBER_6  &kp N7        &kp N8        &kp N9        &kp N0               &trans           &trans          &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS
&kp F6        &kp F7        &kp F8        &kp F9        &kp F10  &trans      &trans           &trans          &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ASTERISK
&trans        &trans        &trans        &trans        &trans   &trans      &kp KP_NUMBER_0  &kp KP_DOT                                                         &kp KP_DIVIDE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        tertiary_layer {
            display-name = "tertiary_layer";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN    &kp HASH      &kp DOLLAR            &kp PERCENT                                &kp PAGE_UP    &kp HOME  &kp UP_ARROW    &kp END    &kp PRINTSCREEN
&kp CARET        &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS              &trans  &kp PAGE_DOWN  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT  &kp SCROLLLOCK
&kp GRAVE        &kp SQT        &kp SEMI      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans      &trans  &trans         &mkp MB4  &trans          &mkp MB5   &kp PAUSE_BREAK
&trans           &trans         &trans        &trans                &trans                 &trans      &trans  &trans                                              &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans  &trans    &trans    &trans     &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &mkp MB1  &mkp MB3  &mkp MB2   &trans              &trans  &trans  &mkp MB1  &mo 8     &mkp MB2  &trans
&trans  &trans    &trans    &trans     &trans  &trans      &trans  &trans  &mkp MB4  &mkp MB5  &trans    &trans
&trans  &trans    &trans    &kp LCTRL  &trans  &trans      &trans  &trans                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        scroll_layer {
            display-name = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
